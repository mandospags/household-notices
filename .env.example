# Test Valley Borough Council bin collection lookup.
# Resolve TVBC_UPRN once via the postcode/address lookup, then keep it fixed here.
TVBC_POSTCODE=SP11 0BY
TVBC_UPRN=100062540413

# DEFRA Daily Air Quality Index forecast station (must match a <title> in
# https://uk-air.defra.gov.uk/assets/rss/forecast.xml)
DAQI_STATION=ANDOVER

# Met Office severe weather warnings region. Hampshire is believed to be
# "se" (London & South East England) rather than "sw" (South West England) -
# unconfirmed since no warning has been observed live to check against; swap
# to "sw" if warnings never line up with what's actually forecast locally.
METOFFICE_REGION=se

# Realtime Trains (RTT) commute rows. Sign up for a free personal token at
# https://api-portal.rtt.io - this is a real credential, not a public
# tenant ID, so leave it blank here and only set it in .env.
RTT_REFRESH_TOKEN=
RTT_ORIGIN=ADV
RTT_DESTINATION=WAT
# Before noon: today = next 2 live ADV->WAT departures, upcoming = preview
# of this evening's WAT->ADV window. From noon: today = next 2 live
# WAT->ADV arrivals, upcoming = preview of tomorrow morning's ADV->WAT
# window.
TRAINS_MORNING_FROM=07:00
TRAINS_MORNING_TO=08:00
TRAINS_EVENING_FROM=17:00
TRAINS_EVENING_TO=18:00

# Alerts (alerts.py): the two usual commute trains to watch for
# delay/cancellation/platform changes, and the delay (minutes vs planned)
# at which a train stops counting as "on time".
TRAINS_USUAL_MORNING=07:35
TRAINS_USUAL_EVENING=17:23
TRAINS_DELAY_ALERT_MIN=3

# TomTom live traffic for the two commute runs (services/traffic.py).
# Free key from https://developer.tomtom.com - real credential, leave blank
# here and only set it in .env. Locations are postcode centroids as
# "lat,lon", geocoded once via https://api.postcodes.io/postcodes/<pc>
# (Home SP11 0BY, Andover station SP10 3HW, St Michael's School RG20 9JW).
TOMTOM_API_KEY=
# Traffic delay (minutes vs free-flow) at which a commute route stops
# counting as "clear" in alerts.py.
TRAFFIC_DELAY_ALERT_MIN=3
TRAFFIC_HOME=51.282323,-1.459207
TRAFFIC_STATION=51.212083,-1.490783
TRAFFIC_SCHOOL=51.344116,-1.331873

# Where alerts.py keeps last-seen state between runs (JSON, gitignored).
# A relative path resolves against the working directory; point it at
# persistent storage in Phase 2.
ALERTS_STATE_FILE=alerts_state.json

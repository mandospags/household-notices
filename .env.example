# Home postcode - shared by services/powercuts.py (matched against SSEN's
# affected-areas list) and documents what services/bins.py's TVBC_UPRN below
# was resolved for. This is the one thing that's actually a single source
# of truth for "where home is"; it does NOT drive everything else below -
# see the "if you move" checklist near the bottom of this file for what
# else needs manually re-deriving.
HOME_POSTCODE=SP11 0BY

# Test Valley Borough Council bin collection lookup.
# Resolve TVBC_UPRN once via the postcode/address lookup, then keep it fixed here.
TVBC_UPRN=100062540413

# DEFRA Daily Air Quality Index forecast station (must match a <title> in
# https://uk-air.defra.gov.uk/assets/rss/forecast.xml)
DAQI_STATION=ANDOVER

# Met Office severe weather warnings region. Hampshire is believed to be
# "se" (London & South East England) rather than "sw" (South West England) -
# unconfirmed since no warning has been observed live to check against; swap
# to "sw" if warnings never line up with what's actually forecast locally.
METOFFICE_REGION=se

# Realtime Trains (RTT) commute rows. Sign up for a free personal token at
# https://api-portal.rtt.io - this is a real credential, not a public
# tenant ID, so leave it blank here and only set it in .env.
RTT_REFRESH_TOKEN=
RTT_ORIGIN=ADV
RTT_DESTINATION=WAT

# The two usual commute trains - anchor both the digest boards (each shows
# the usual train plus the nearest one either side, ~3 total) and the
# alerts.py watch, which needs an exact scheduled-time match (not a
# window) - so this must be the real timetabled time, not an approximation.
TRAINS_USUAL_MORNING=07:35
TRAINS_USUAL_EVENING=17:23
# Before this time: today = board around TRAINS_USUAL_MORNING, upcoming =
# board around TRAINS_USUAL_EVENING (today's return). From this time on:
# today = board around TRAINS_USUAL_EVENING, upcoming = tomorrow morning's
# board (next weekday if tomorrow's a weekend). Not noon - this is "the
# latest I'd still count as having arrived today".
TRAINS_MORNING_CUTOFF=10:00
TRAINS_DELAY_ALERT_MIN=3

# TomTom live traffic for the two commute runs (services/traffic.py).
# Free key from https://developer.tomtom.com - real credential, leave blank
# here and only set it in .env. Locations are postcode centroids as
# "lat,lon", geocoded once via https://api.postcodes.io/postcodes/<pc>
# (Home SP11 0BY, Andover station SP10 3HW, St Michael's School RG20 9JW).
TOMTOM_API_KEY=
# Traffic delay (minutes vs free-flow) at which a commute route stops
# counting as "clear" in alerts.py.
TRAFFIC_DELAY_ALERT_MIN=3
TRAFFIC_HOME=51.282323,-1.459207
TRAFFIC_STATION=51.212083,-1.490783
TRAFFIC_SCHOOL=51.344116,-1.331873

# Weekly Mass times bulletin (services/mass.py) - the chapel row to match
# on the fsspx.uk district page (exact link text).
MASS_CHAPEL_NAME=Burghclere

# Where mass.py caches the parsed weekly table (JSON, gitignored). The page
# fails Cloudflare 520s often from some networks, so a cache hit within an
# hour skips the live fetch entirely, and a stale cache is served if a
# re-fetch fails outright.
MASS_CACHE_FILE=mass_cache.json

# Where alerts.py keeps last-seen state between runs (JSON, gitignored).
# A relative path resolves against the working directory; point it at
# persistent storage in Phase 2.
ALERTS_STATE_FILE=alerts_state.json

# Telegram notify bot ("Home") - send-only, real credential shared with homelab-mcp's
# own .env (same bot, different producer). This repo only ever calls sendMessage,
# never getUpdates - real values belong only in .env, never here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- If home ever moves ---
# HOME_POSTCODE above is the only thing that's a single change. Everything
# else here is derived from the postcode/address but has to be
# re-derived by hand, since there's no live geocoding step in this repo:
#   - TVBC_UPRN: re-run the postcode/address lookup for the new council/address
#   - DAQI_STATION: nearest DEFRA forecast station for the new area
#   - METOFFICE_REGION: correct warnings region for the new area
#   - RTT_ORIGIN (and TRAINS_USUAL_MORNING/EVENING): new home station and
#     actual commute times, if commuting at all from the new address
#   - TRAFFIC_HOME/STATION/SCHOOL: re-geocode via postcodes.io for the new
#     home/station/school locations

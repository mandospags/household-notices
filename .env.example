# Test Valley Borough Council bin collection lookup.
# Resolve TVBC_UPRN once via the postcode/address lookup, then keep it fixed here.
TVBC_POSTCODE=SP11 0BY
TVBC_UPRN=100062540413

# DEFRA Daily Air Quality Index forecast station (must match a <title> in
# https://uk-air.defra.gov.uk/assets/rss/forecast.xml)
DAQI_STATION=ANDOVER

# Met Office severe weather warnings region. Hampshire is believed to be
# "se" (London & South East England) rather than "sw" (South West England) -
# unconfirmed since no warning has been observed live to check against; swap
# to "sw" if warnings never line up with what's actually forecast locally.
METOFFICE_REGION=se

# Realtime Trains (RTT) commute rows. Sign up for a free personal token at
# https://api-portal.rtt.io - this is a real credential, not a public
# tenant ID, so leave it blank here and only set it in .env.
RTT_REFRESH_TOKEN=
RTT_ORIGIN=ADV
RTT_DESTINATION=WAT
# Before noon: today = next 2 live ADV->WAT departures, upcoming = preview
# of this evening's WAT->ADV window. From noon: today = next 2 live
# WAT->ADV arrivals, upcoming = preview of tomorrow morning's ADV->WAT
# window.
TRAINS_MORNING_FROM=07:00
TRAINS_MORNING_TO=08:00
TRAINS_EVENING_FROM=17:00
TRAINS_EVENING_TO=18:00
